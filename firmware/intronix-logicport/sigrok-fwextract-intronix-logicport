"""Extract the FPGA bitstreams for the Intronix LogicPort LA1034 from the
vendor's LogicPort.ccf file (installed with the LogicPort software).

LogicPort.ccf layout:
  * first line (CRLF terminated): comma separated decimal numbers N0..N8;
    len_k = N_k ^ 0x916662 is the size of image k in units of 16 bytes,
    N8 ^ 0x916662 is the XOR of len_0..len_7 (checksum).
  * 8 images follow, back to back. Each is an FT245 async bit-bang stream:
    one configuration bit per byte pair (DCLK low, DCLK high), bit0 = DATA0,
    bit1 = DCLK, bit2 = nCONFIG. In every image the first two 4 KiB blocks
    are swapped.
This script undoes the block swap and packs the data bits (LSB first) into
plain Altera raw binary files (.rbf), which the libsigrok driver bit-bangs.
"""

import sys, os, hashlib, binascii

# Image index in LogicPort.ccf -> output file name.
NAMES = {
    0: 'intronix-logicport-state-after.rbf',          # state mode, sample 2.5ns after edge
    1: 'intronix-logicport-state-before-clk1-rise.rbf',
    2: 'intronix-logicport-state-before-clk2-rise.rbf',
    3: 'intronix-logicport-state-before-clk1-fall.rbf',
    4: 'intronix-logicport-state-before-clk2-fall.rbf',
    5: 'intronix-logicport-state-on.rbf',             # state mode, sample on edge
    6: 'intronix-logicport-timing-ddr.rbf',           # timing mode, 500 MHz
    7: 'intronix-logicport-timing-sdr.rbf',           # timing mode, <= 250 MHz
}

KNOWN = {
    # sha256 of LogicPort.ccf as shipped in logicport_2371.exe (build 2371)
    '9298a5eacb3cf1a791b8ce48460a19e031eb81baffa378bab3f94f2d78483f9c': 'build 2371',
}

def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)

def extract(data):
    eol = data.index(b'\r\n')
    nums = [int(x) for x in data[:eol].decode('ascii').split(',')]
    if len(nums) != 9:
        die('Unexpected header.')
    lens = [n ^ 0x916662 for n in nums]
    chk = 0
    for v in lens[:8]:
        chk ^= v
    if chk != lens[8]:
        die('Header checksum mismatch.')
    off = eol + 2
    images = []
    for v in lens[:8]:
        seg = bytearray(data[off:off + v * 16])
        seg[0:4096], seg[4096:8192] = seg[4096:8192], seg[0:4096]
        off += v * 16
        if any(b & 0xf8 != 0 or not b & 4 for b in seg):
            die('Unexpected bit-bang stream content.')
        bits = seg[0::2]
        rbf = bytearray(len(bits) // 8)
        for i in range(len(rbf)):
            b = 0
            for j in range(8):
                b |= (bits[i * 8 + j] & 1) << j
            rbf[i] = b
        images.append(bytes(rbf))
    if off != len(data):
        die('Trailing data in file.')
    return images

def main():
    if len(sys.argv) != 2:
        die('Usage: %s <path/to/LogicPort.ccf>' % os.path.basename(sys.argv[0]))
    data = open(sys.argv[1], 'rb').read()
    digest = hashlib.sha256(data).hexdigest()
    if digest not in KNOWN:
        print('Warning: unknown LogicPort.ccf (sha256 %s); trying anyway.' % digest)
    for i, rbf in enumerate(extract(data)):
        if not rbf.startswith(b'\xff' * 16 + b'\x6a'):
            die('Image %d does not look like an Altera RBF.' % i)
        with open(NAMES[i], 'wb') as f:
            f.write(rbf)
        print('saved %d bytes to %s (crc32 %08x)' % (len(rbf), NAMES[i], binascii.crc32(rbf) & 0xffffffff))

main()
